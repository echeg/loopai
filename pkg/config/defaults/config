# loopai configuration
# copy this file to ~/.config/loopai/config and modify as needed
#
# config values in this file can be overridden by CLI flags.
# precedence (highest to lowest): CLI flags > local config (.loopai/) > global config (~/.config/loopai/) > embedded defaults
#
# NOTE: inline comments (e.g., "key = value # comment") are NOT supported.
# use full-line comments starting with # on a separate line instead.
# this is required to support hex color values like #00ff00.

# ------------------------------------------------------------------------------
# claude executor
# ------------------------------------------------------------------------------

# claude_command: the command to run claude code
# default: "claude"
claude_command = claude

# claude_args: arguments passed to claude command
# --dangerously-skip-permissions: bypass permission prompts for autonomous execution
# --output-format stream-json: output JSON events for progress tracking
# --verbose: enable detailed logging
claude_args = --dangerously-skip-permissions --output-format stream-json --verbose

# claude_swap_enabled: when true and claude-swap is found in PATH, rotate to the
# next available managed account after Claude returns a configured limit pattern.
# loopai coordinates concurrent runs globally and never reads or stores tokens.
# default: true
claude_swap_enabled = true

# plan_model: model to use for interactive plan creation
# syntax: model[:effort] where model is fable/opus/sonnet/haiku (or a full model ID like
# claude-sonnet-4-5-20250929) and effort is low/medium/high/xhigh/max.
# either part is optional: "opus" sets model only, ":high" sets effort only,
# "opus:high" sets both. falls back to task_model when empty.
# under the codex executor (executor = codex) this selects the codex plan-creation
# model/effort, resolved against codex_model/codex_reasoning_effort.
# plan_model =

# task_model: model to use for task execution
# same model[:effort] syntax as plan_model. leave empty to use Claude CLI's defaults.
# under the codex executor this selects the codex task-phase model/effort.
# task_model =

# review_model: model to use for review phases (first review, fix loops, finalize)
# same model[:effort] syntax as plan_model.
# falls back to task_model if not set, then to Claude CLI's defaults.
# use a cheaper/faster model (e.g., sonnet) or lower effort for reviews to reduce cost.
# under the codex executor this selects the codex review-phase model/effort.
# review_model =

# ------------------------------------------------------------------------------
# codex executor
# ------------------------------------------------------------------------------

# executor: primary executor for plan creation, task, review, external-finding
# evaluation, and finalize phases. empty/default uses Claude Code; "codex" runs
# the primary pipeline through codex
# executor =

# pass_claude_md: when executor = codex, let codex read project CLAUDE.md via
# project_doc_fallback_filenames. user-level ~/.claude/CLAUDE.md is not
# auto-passed; loopai prints a one-time symlink hint instead.
# default: false
# pass_claude_md = false

# codex_enabled: backward-compatible gate for automatically selected external review
# set to false to disable external review when external_review_tool = auto
# default: true
codex_enabled = true

# codex_command: the command to run openai codex
# default: "codex"
codex_command = codex

# codex_args: extra arguments appended to every codex invocation loopai spawns
# (both executor = codex and external codex review under a claude primary).
# unlike claude_args, which IS the claude command's argument list, these are
# strictly additive: loopai composes the codex command and appends these last,
# so an explicit -c value here overrides the matching override loopai sets.
# example: keep long autonomous runs off the priority tier while interactive
# codex sessions keep service_tier = "priority" in ~/.codex/config.toml
# example: codex_args = -c service_tier="default"
#
# the value is tokenized like a shell word list: quotes group whitespace but are
# then removed, and backslashes follow shell rules (literal in single quotes,
# escaping \" and \\ in double quotes, escaping the next character unquoted).
# codex parses each -c value as TOML and falls back to a literal
# string, so the example above works, but a value whose TOML *type* depends on
# its quotes must escape them or codex fails to load its config and every codex
# phase dies at startup:
#   codex_args = -c project_doc_fallback_filenames=[\"CLAUDE.md\"]
#
# last-occurrence-wins covers -c key=value only. repeating any flag loopai
# already passes, valued or bare, is a fatal codex parse error, not an override,
# so use codex_sandbox rather than putting --sandbox here. executor = codex also
# passes --dangerously-bypass-approvals-and-sandbox whenever the effective
# sandbox is danger-full-access (its default), so repeating that one aborts
# every phase too. extras land after the exec
# subcommand, so an option only the top-level codex command accepts (--search)
# is a fatal unexpected-argument error. a bare positional token becomes codex
# exec's prompt and demotes loopai's own to a trailing <stdin> block.
#
# extras are trusted like codex_command: they also reach the external codex
# reviewer that loopai otherwise pins to a read-only sandbox, where loopai emits
# no bypass flag, so --dangerously-bypass-approvals-and-sandbox is accepted
# alongside that pin and grants the reviewer write access.
# default: empty (codex invocations are unchanged)
# codex_args =

# codex_model: model ID for codex
# available models: gpt-5.5, gpt-5.3-codex, gpt-5.3-codex-mini
# default: gpt-5.5
# (set to an empty value, "codex_model =", to inherit from ~/.codex/config.toml instead;
# commenting the line out keeps the gpt-5.5 default)
codex_model = gpt-5.5

# codex_reasoning_effort: reasoning effort level for codex
# available: low, medium, high, xhigh
# default: xhigh
# (set to an empty value, "codex_reasoning_effort =", to inherit from ~/.codex/config.toml
# instead; commenting the line out keeps the xhigh default)
codex_reasoning_effort = xhigh

# codex_timeout_ms: timeout for codex execution in milliseconds
# default: 3600000 (1 hour)
codex_timeout_ms = 3600000

# codex_sandbox: sandbox mode for codex execution
# available: read-only, workspace-write, danger-full-access
# read-only: codex can read files but not write (safest for external review)
# danger-full-access: codex runs without filesystem sandboxing, matching autonomous claude mode
# note: first-class executor = codex uses danger-full-access unless codex_sandbox is explicitly set in user config
# default: read-only for external codex review, danger-full-access for executor = codex
codex_sandbox = read-only

# ------------------------------------------------------------------------------
# external review
# ------------------------------------------------------------------------------

# external_review_tool: which tool to use for external code review
# available: auto, claude, codex, custom, none
# auto: use Codex for a Claude primary executor and Claude for a Codex primary executor
# claude: use Claude Code for external review
# codex: use OpenAI Codex for external review
# custom: use a custom script specified by custom_review_script
# none: skip external review entirely
# note: codex_enabled = false disables auto selection for backward compatibility
# external-only mode still resolves auto because the external pipeline was explicitly requested
# default: auto
external_review_tool = auto

# external_review_model: model[:effort] for the selected external provider
# empty uses codex_model/codex_reasoning_effort for Codex or opus:xhigh for Claude
# explicit values override the selected provider's dynamic default
# must remain empty when external_review_tool = custom
external_review_model =

# external_reviewers: ordered comma-separated provider[:model[:effort]] chain
# available providers: claude, codex, custom
# example: external_reviewers = codex:gpt-5.5:xhigh, claude:fable:max
# when set, takes precedence over external_review_tool and external_review_model
# an explicitly empty value clears an inherited chain and disables external review
# reviewers run sequentially until clean, their per-reviewer iteration cap, or patience
# bare claude defaults to opus:xhigh; bare codex uses the configured codex defaults
# max effort is Claude-only; Codex ignores it with a warning
# providers may repeat; every entry creates a separate review loop
# reviewers only report findings; the primary fixes them using review_model (or task_model)
# custom entries must not specify a model and use custom_review_script
# external_reviewers =

# custom_review_script: path to custom review script
# required by external_review_tool = custom and custom entries in external_reviewers
# script receives prompt file path as single argument
# script should output findings to stdout; the primary evaluator emits
# <<<RALPHEX:EXTERNAL_REVIEW_DONE>>> when the reviewer reports no issues
# customized prompts using legacy <<<RALPHEX:CODEX_REVIEW_DONE>>> remain supported
# example: custom_review_script = ~/.config/loopai/scripts/my-review.sh
# custom_review_script =

# ------------------------------------------------------------------------------
# finalize step
# ------------------------------------------------------------------------------

# finalize_enabled: whether to run finalize step after successful review phases
# runs once at the end, best-effort (failures logged but don't block success)
# default: false
# finalize_enabled = false

# ------------------------------------------------------------------------------
# claude authentication
# ------------------------------------------------------------------------------

# preserve_anthropic_api_key: when true, ANTHROPIC_API_KEY is passed through to
# the child claude process. enable this if you authenticate Claude Code via API
# key (ANTHROPIC_API_KEY) rather than OAuth/keychain login. by default the key
# is stripped so a host-set key cannot silently override OAuth credentials and
# bill a different account.
# default: false
# preserve_anthropic_api_key = false

# ------------------------------------------------------------------------------
# plan move behavior
# ------------------------------------------------------------------------------

# move_plan_on_completion: whether to move completed plan file into
# docs/plans/completed/ on success. set to false for workflows that
# manage plan file lifecycle externally (e.g. spec-driven tooling with
# separate archive steps).
# default: true
move_plan_on_completion = true

# ------------------------------------------------------------------------------
# worktree isolation
# ------------------------------------------------------------------------------

# use_worktree: run each plan in an isolated git worktree
# cuts the plan branch from the current HEAD and creates
# .loopai/worktrees/<plan-name> for parallel execution
# default: false
# use_worktree = false

# ------------------------------------------------------------------------------
# timing
# ------------------------------------------------------------------------------

# iteration_delay_ms: delay between iterations in milliseconds
# allows for file system sync and prevents rate limiting
# default: 2000
iteration_delay_ms = 2000

# task_retry_count: number of retries if a task fails
# 0 = no retries, 1 = one retry (total 2 attempts)
# default: 1
task_retry_count = 1

# max_iterations: maximum task iterations per plan execution
# can also be set via --max-iterations CLI flag (CLI takes precedence)
# default: 50
# max_iterations = 50

# max_external_iterations: override external review iteration limit
# 0 = auto (derived from max_iterations as max(3, max_iterations/5))
# set to a positive value to use a fixed count independently for each reviewer
# default: 0
# max_external_iterations = 0

# review_patience: terminate external review after N consecutive unchanged rounds
# when the external reviewer and primary evaluator can't agree on findings, the loop
# runs until max_external_iterations. set review_patience to break early when
# N consecutive rounds produce no commits or working-tree changes. patience resets
# independently for each reviewer in a chain.
# 0 = disabled (loop runs to max iterations)
# default: 0
# review_patience = 0

# session_timeout: maximum duration for a single executor session
# kills hanging sessions (e.g., agent started a blocking operation)
# applies to claude in default executor mode; under --codex applies to every executor call;
# external codex/custom review in Claude mode is not affected
# uses Go duration format (e.g., "30m", "1h", "1h30m")
# omit or leave empty to disable (no timeout)
# session_timeout =

# idle_timeout: kill executor session after no output for this duration
# unlike session_timeout (fixed wall-clock limit), idle timeout resets on each
# output line and only fires when the session goes silent
# applies to the claude executor in default mode and to every executor call
# under --codex; external codex review in default-claude mode is NOT affected;
# custom external review is not affected
# uses Go duration format (e.g., "5m", "10m", "30m")
# omit or leave empty to disable (no timeout)
# idle_timeout =

# ------------------------------------------------------------------------------
# paths
# ------------------------------------------------------------------------------

# plans_dir: directory where plan files are located
# relative paths are resolved from the project root
# default: docs/plans
plans_dir = docs/plans

# backlog_dir: directory where agents file out-of-scope findings, one markdown file per entry
# relative paths are resolved from the project root, the directory is committed with the branch
# loopai never reads or creates it, the path is only substituted into prompts as {{BACKLOG_DIR}}
# default: docs/backlog
backlog_dir = docs/backlog

# default_branch: override the auto-detected default branch used for code review
# by default, loopai detects the default branch from origin/HEAD or fallbacks to main/master,
# set this to override for projects using non-standard branch names or Git flow
# default_branch = dev

# watch_dirs: directories to watch for progress files in dashboard mode
# comma-separated list of paths, relative paths resolved from project root
# if not specified, defaults to current working directory
# example: watch_dirs = /home/user/projects, /var/log/loopai
# watch_dirs =

# ------------------------------------------------------------------------------
# version control
# ------------------------------------------------------------------------------

# vcs_command: the VCS command used by loopai's git backend
# set to a custom Git-compatible executable or wrapper
# the command receives the same arguments as git and must return compatible output
# default: git
vcs_command = git

# commit_trailer: trailer line appended to all loopai-orchestrated git commits
# useful for attribution or tracking (e.g., Co-authored-by lines)
# example: commit_trailer = Co-authored-by: loopai <noreply@loopai.local>
# default: empty (disabled)
# commit_trailer =

# ------------------------------------------------------------------------------
# error pattern detection
# ------------------------------------------------------------------------------

# claude_error_patterns: patterns to detect in claude output indicating errors
# comma-separated list of substrings (case-insensitive matching)
# when detected, loopai exits gracefully with an informative message
# default: You've hit your limit,You've hit your session limit,API Error:,cannot be launched inside another Claude Code session,Not logged in,Your usage allocation has been disabled by your admin,You've hit your org's monthly usage limit
claude_error_patterns = You've hit your limit,You've hit your session limit,API Error:,cannot be launched inside another Claude Code session,Not logged in,Your usage allocation has been disabled by your admin,You've hit your org's monthly usage limit

# codex_error_patterns: patterns to detect in codex output indicating errors
# comma-separated list of substrings (case-insensitive matching)
# when detected, loopai exits gracefully with an informative message
# default: Rate limit exceeded,rate limit reached,429 Too Many Requests,quota exceeded,insufficient_quota,You've hit your usage limit
codex_error_patterns = Rate limit exceeded,rate limit reached,429 Too Many Requests,quota exceeded,insufficient_quota,You've hit your usage limit

# ------------------------------------------------------------------------------
# transient retry pattern detection
# ------------------------------------------------------------------------------

# claude_retry_patterns: transient claude/fya output markers to retry like timeouts
# comma-separated list of substrings (case-insensitive matching)
# default: FYA_TRANSIENT_TIMEOUT,API Error: 529,API Error: 502,API Error: 503,API Error: 504
claude_retry_patterns = FYA_TRANSIENT_TIMEOUT,API Error: 529,API Error: 502,API Error: 503,API Error: 504

# ------------------------------------------------------------------------------
# rate limit wait and retry
# ------------------------------------------------------------------------------

# claude_limit_patterns: patterns to detect rate limits in claude output
# comma-separated list of substrings (case-insensitive matching)
# when detected, loopai waits for wait_on_limit and retries until success or Ctrl+C
# transient HTTP errors (529/502/503/504) live in claude_retry_patterns, not here
# default: You've hit your limit,You've hit your session limit,Your usage allocation has been disabled by your admin,You've hit your org's monthly usage limit
claude_limit_patterns = You've hit your limit,You've hit your session limit,Your usage allocation has been disabled by your admin,You've hit your org's monthly usage limit

# codex_limit_patterns: patterns to detect rate limits in codex/external output
# comma-separated list of substrings (case-insensitive matching)
# same retry behavior as claude_limit_patterns
# default: Rate limit exceeded,rate limit reached,429 Too Many Requests,quota exceeded,insufficient_quota,You've hit your usage limit
codex_limit_patterns = Rate limit exceeded,rate limit reached,429 Too Many Requests,quota exceeded,insufficient_quota,You've hit your usage limit

# wait_on_limit: duration to wait before retrying after a rate limit is detected
# uses Go duration format (e.g., "1h", "30m", "1h30m", "90s")
# default: 10m; set to 0s (or pass --wait 0) to fail immediately
wait_on_limit = 10m

# ------------------------------------------------------------------------------
# notifications (optional, disabled by default)
# ------------------------------------------------------------------------------

# notify_channels: comma-separated list of channels to use
# available: telegram, email, slack, webhook, custom
# leave empty or omit to disable notifications entirely
# example: notify_channels = telegram, webhook
# notify_channels =

# notify_on_error: send notification when execution fails
# default: true
# notify_on_error = true

# notify_on_complete: send notification when execution succeeds
# default: true
# notify_on_complete = true

# notify_timeout_ms: total timeout for all notification channels in milliseconds
# default: 10000
# notify_timeout_ms = 10000

# --- telegram ---

# notify_telegram_token: bot token from BotFather
# notify_telegram_token =

# notify_telegram_chat: chat ID or channel name (e.g., @mychannel or 123456789)
# notify_telegram_chat =

# --- slack ---

# notify_slack_token: slack bot oauth token (xoxb-...)
# notify_slack_token =

# notify_slack_channel: channel name or ID to post to
# notify_slack_channel =

# --- email (SMTP) ---

# notify_smtp_host: SMTP server hostname
# notify_smtp_host =

# notify_smtp_port: SMTP server port
# default: 587
# notify_smtp_port = 587

# notify_smtp_username: SMTP authentication username
# notify_smtp_username =

# notify_smtp_password: SMTP authentication password
# notify_smtp_password =

# notify_smtp_starttls: use STARTTLS for SMTP connection
# default: false
# notify_smtp_starttls = false

# notify_email_from: sender email address
# notify_email_from =

# notify_email_to: comma-separated list of recipient email addresses
# notify_email_to =

# --- webhook ---

# notify_webhook_urls: comma-separated list of webhook endpoint URLs
# the notification message is POSTed as plain text to each URL
# notify_webhook_urls =

# --- custom script ---

# notify_custom_script: path to custom notification script
# script receives Result JSON on stdin, exit 0 = success, non-zero = failure
# timeout controlled by notify_timeout_ms
# example: notify_custom_script = ~/.config/loopai/scripts/notify.sh
# notify_custom_script =

# ------------------------------------------------------------------------------
# output colors (hex format: #RRGGBB)
# ------------------------------------------------------------------------------

# color_task: task execution phase (green)
color_task = #2e8b57

# color_review: review phase (teal)
color_review = #1a9e9e

# color_codex: external review phase (legacy key, purple)
color_codex = #9b59b6

# color_claude_eval: external findings evaluation phase (legacy key, blue)
color_claude_eval = #5b8dd9

# color_warn: warning messages (amber)
color_warn = #d4930d

# color_error: error messages (red)
color_error = #cc0000

# color_signal: completion/failure signals (red)
color_signal = #d25252

# color_timestamp: timestamp prefix (gray)
color_timestamp = #707070

# color_info: informational messages (gray)
color_info = #808080
